{
  "contract_version": "1.0.0",
  "metadata": {
    "source_system": "string; one of M5, OLIST, SCMS",
    "source_record_id": "string; original source row identifier or stable source-grain identifier"
  },
  "systems": {
    "m5": {
      "dim_product": {
        "primary_key": [
          "item_id"
        ],
        "columns": {
          "item_id": "string",
          "dept_id": "string",
          "cat_id": "string",
          "source_system": "string",
          "source_record_id": "string; source or deterministic technical identifier"
        }
      },
      "dim_store": {
        "primary_key": [
          "store_id"
        ],
        "columns": {
          "store_id": "string",
          "state_id": "string",
          "source_system": "string",
          "source_record_id": "string; source or deterministic technical identifier"
        }
      },
      "dim_date": {
        "primary_key": [
          "day_id"
        ],
        "columns": {
          "day_id": "string",
          "date": "date",
          "wm_yr_wk": "int",
          "weekday": "string",
          "wday": "int",
          "month": "int",
          "year": "int",
          "event_name_1": "string nullable",
          "event_type_1": "string nullable",
          "event_name_2": "string nullable",
          "event_type_2": "string nullable",
          "snap_CA": "int",
          "snap_TX": "int",
          "snap_WI": "int",
          "source_system": "string",
          "source_record_id": "string; source or deterministic technical identifier"
        }
      },
      "fact_sales": {
        "primary_key": [
          "sales_date",
          "sku",
          "store_id"
        ],
        "foreign_keys": {
          "sku": "dim_product.item_id",
          "store_id": "dim_store.store_id",
          "sales_date": "dim_date.date"
        },
        "columns": {
          "sales_date": "date",
          "sku": "string",
          "store_id": "string",
          "quantity_sold": "int64",
          "unit_price": "float64 nullable when no matching sell-price row",
          "dept_id": "string",
          "category_id": "string",
          "state_id": "string",
          "wm_yr_wk": "int",
          "source_system": "string",
          "source_record_id": "string"
        }
      },
      "fact_sell_prices": {
        "primary_key": [
          "store_id",
          "sku",
          "wm_yr_wk"
        ],
        "columns": {
          "store_id": "string",
          "sku": "string",
          "wm_yr_wk": "int",
          "unit_price": "float64",
          "source_system": "string",
          "source_record_id": "string; source or deterministic technical identifier"
        }
      }
    },
    "olist": {
      "fact_orders": {
        "primary_key": [
          "order_id"
        ],
        "foreign_keys": {
          "customer_id": "dim_customer.customer_id"
        },
        "columns": {
          "order_id": "string",
          "customer_id": "string",
          "order_status": "string",
          "order_purchase_timestamp": "timestamp nullable",
          "order_approved_at": "timestamp nullable",
          "order_delivered_carrier_date": "timestamp nullable",
          "order_delivered_customer_date": "timestamp nullable",
          "order_estimated_delivery_date": "timestamp nullable",
          "source_system": "string",
          "source_record_id": "string"
        }
      },
      "fact_order_items": {
        "primary_key": [
          "order_id",
          "order_item_id"
        ],
        "foreign_keys": {
          "order_id": "fact_orders.order_id",
          "product_id": "dim_olist_product.product_id",
          "seller_id": "dim_seller.seller_id"
        },
        "columns": {
          "order_id": "string",
          "order_item_id": "int",
          "product_id": "string",
          "seller_id": "string",
          "shipping_limit_date": "timestamp nullable",
          "price": "float64",
          "freight_value": "float64",
          "source_system": "string",
          "source_record_id": "string"
        }
      },
      "dim_customer": {
        "primary_key": [
          "customer_id"
        ],
        "columns": {
          "customer_id": "string",
          "customer_unique_id": "string",
          "customer_zip_code_prefix": "string",
          "customer_city": "string",
          "customer_state": "string",
          "source_system": "string",
          "source_record_id": "string"
        }
      },
      "dim_seller": {
        "primary_key": [
          "seller_id"
        ],
        "columns": {
          "seller_id": "string",
          "seller_zip_code_prefix": "string",
          "seller_city": "string",
          "seller_state": "string",
          "source_system": "string",
          "source_record_id": "string"
        }
      },
      "dim_olist_product": {
        "primary_key": [
          "product_id"
        ],
        "columns": {
          "product_id": "string",
          "product_category_name": "string nullable",
          "product_name_length": "numeric nullable",
          "product_description_length": "numeric nullable",
          "product_photos_qty": "numeric nullable",
          "product_weight_g": "numeric nullable",
          "product_length_cm": "numeric nullable",
          "product_height_cm": "numeric nullable",
          "product_width_cm": "numeric nullable",
          "source_system": "string",
          "source_record_id": "string"
        }
      },
      "fact_order_payments": {
        "primary_key": [
          "order_id",
          "payment_sequential"
        ],
        "foreign_keys": {
          "order_id": "fact_orders.order_id"
        },
        "columns": {
          "order_id": "string",
          "payment_sequential": "int",
          "payment_type": "string",
          "payment_installments": "int",
          "payment_value": "float64",
          "source_system": "string",
          "source_record_id": "string"
        }
      }
    },
    "scms": {
      "fact_procurement": {
        "primary_key": [
          "procurement_id"
        ],
        "foreign_keys": {
          "supplier_key": "dim_supplier.supplier_key",
          "product_scms_key": "dim_product_scms.product_scms_key"
        },
        "columns": {
          "procurement_id": "int source ID",
          "project_code": "string",
          "pq_number": "string",
          "po_so_number": "string",
          "supplier_key": "string",
          "product_scms_key": "string",
          "line_item_quantity": "int64 nullable",
          "unit_of_measure_per_pack": "int64 nullable",
          "line_item_value_usd": "float64 nullable",
          "pack_price_usd": "float64 nullable",
          "unit_price_usd": "float64 nullable",
          "country": "string",
          "source_system": "string",
          "source_record_id": "string",
          "pq_first_sent_to_client_date_source": "string; original source value",
          "po_sent_to_vendor_date_source": "string; original source value",
          "pq_first_sent_to_client_date": "date nullable",
          "po_sent_to_vendor_date": "date nullable"
        }
      },
      "fact_delivery": {
        "primary_key": [
          "procurement_id"
        ],
        "foreign_keys": {
          "shipment_key": "dim_shipment.shipment_key",
          "supplier_key": "dim_supplier.supplier_key",
          "product_scms_key": "dim_product_scms.product_scms_key"
        },
        "columns": {
          "procurement_id": "int source ID",
          "shipment_key": "string",
          "supplier_key": "string",
          "product_scms_key": "string",
          "shipment_mode": "string nullable",
          "fulfill_via": "string",
          "scheduled_delivery_date": "date nullable",
          "delivered_to_client_date": "date nullable",
          "delivery_recorded_date": "date nullable",
          "days_late_vs_schedule": "int nullable",
          "line_item_quantity": "int64 nullable",
          "weight_kg": "float64 nullable",
          "freight_cost_usd": "float64 nullable",
          "line_item_insurance_usd": "float64 nullable",
          "source_system": "string",
          "source_record_id": "string",
          "weight_kg_source": "string; original source text retained for non-numeric annotations",
          "freight_cost_usd_source": "string; original source text retained for non-numeric annotations",
          "line_item_insurance_usd_source": "string; original source text retained"
        }
      },
      "dim_supplier": {
        "primary_key": [
          "supplier_key"
        ],
        "columns": {
          "supplier_key": "string generated deterministic hash",
          "vendor_name": "string nullable",
          "manufacturing_site": "string nullable",
          "managed_by": "string nullable",
          "country": "string nullable",
          "source_system": "string",
          "source_record_id": "string; source or deterministic technical identifier"
        }
      },
      "dim_shipment": {
        "primary_key": [
          "shipment_key"
        ],
        "columns": {
          "shipment_key": "string generated deterministic hash",
          "asn_dn_number": "string nullable",
          "po_so_number": "string nullable",
          "shipment_mode": "string nullable",
          "fulfill_via": "string nullable",
          "vendor_inco_term": "string nullable",
          "country": "string nullable",
          "source_system": "string",
          "source_record_id": "string; source or deterministic technical identifier"
        }
      },
      "dim_product_scms": {
        "primary_key": [
          "product_scms_key"
        ],
        "columns": {
          "product_scms_key": "string generated deterministic hash",
          "product_group": "string nullable",
          "sub_classification": "string nullable",
          "item_description": "string nullable",
          "molecule_test_type": "string nullable",
          "brand": "string nullable",
          "dosage": "string nullable",
          "dosage_form": "string nullable",
          "unit_of_measure_per_pack": "numeric nullable",
          "source_system": "string",
          "source_record_id": "string; source or deterministic technical identifier"
        }
      }
    }
  }
}